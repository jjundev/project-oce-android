{
  "name": "oce-functions",
  "version": "0.0.1",
  "private": true,
  "description": "딸깍영어 v1 백엔드 — /llm 프록시 골격 (M0-07)",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint --ext .ts src",
    "test": "jest",
    "serve": "npm run build && firebase emulators:start --only functions",
    "smoke": "npm run build && firebase emulators:exec --only functions \"echo emulator up — hit http://127.0.0.1:5001 for /llm\"",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "firebase-functions-test": "^3.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "typescript": "^5.4.5"
  }
}
