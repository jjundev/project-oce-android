{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/dialogue/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Pretendard))/i]",
        "message": "Font not provided by the design system. Available: Pretendard."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|natural|correct|streak|gold|brand)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'natural' | 'correct' | 'streak' | 'gold' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: value, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|maxHeight|children|style|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: open, onClose, maxHeight, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|disabled|loading|leadingIcon|trailingIcon|fullWidth|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, disabled, loading, leadingIcon, trailingIcon, fullWidth, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:gradient|padding|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: gradient, padding, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:speaker|playing|onReplay|children|style|key|ref|className|style|children)$/]",
        "message": "<ChatBubble> doesn't accept that prop. Declared props: speaker, playing, onReplay, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute[name.name='speaker'] > Literal[value!=/^(?:user|opponent)$/]",
        "message": "<ChatBubble> speaker must be one of 'user' | 'opponent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedbackSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|state|icon|accent|onRetry|children|style|key|ref|className|style|children)$/]",
        "message": "<FeedbackSection> doesn't accept that prop. Declared props: label, state, icon, accent, onRetry, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedbackSection'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:Loading|Ready|ErrorRecoverable|Error)$/]",
        "message": "<FeedbackSection> state must be one of 'Loading' | 'Ready' | 'ErrorRecoverable' | 'Error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedbackSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|score|slimState|showDeep|onMore|onNext|style|key|ref|className|style|children)$/]",
        "message": "<FeedbackSheet> doesn't accept that prop. Declared props: open, onClose, score, slimState, showDeep, onMore, onNext, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedbackSheet'] > JSXAttribute[name.name='slimState'] > Literal[value!=/^(?:Loading|Ready|ErrorRecoverable|ErrorBlocked)$/]",
        "message": "<FeedbackSheet> slimState must be one of 'Loading' | 'Ready' | 'ErrorRecoverable' | 'ErrorBlocked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|weight|fill|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, weight, fill, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|size|iconSize|disabled|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, size, iconSize, disabled, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|label|helper|error|disabled|trailingIcon|onTrailingClick|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, onChange, placeholder, label, helper, error, disabled, trailingIcon, onTrailingClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:leadingIcon|iconColor|title|subtitle|trailing|showChevron|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: leadingIcon, iconColor, title, subtitle, trailing, showChevron, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MicButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|onClick|disabled|size|style|key|ref|className|style|children)$/]",
        "message": "<MicButton> doesn't accept that prop. Declared props: state, onClick, disabled, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MicButton'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:Ready|Recording|Analyzing|Complete)$/]",
        "message": "<MicButton> state must be one of 'Ready' | 'Recording' | 'Analyzing' | 'Complete'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RewardStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:xp|minutes|streak|animate|style|key|ref|className|style|children)$/]",
        "message": "<RewardStrip> doesn't accept that prop. Declared props: xp, minutes, streak, animate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SavedCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|term|meaning|example|saved|onToggleSave|style|key|ref|className|style|children)$/]",
        "message": "<SavedCard> doesn't accept that prop. Declared props: type, term, meaning, example, saved, onToggleSave, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SavedCard'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:WORD|SENTENCE|EXPRESSION)$/]",
        "message": "<SavedCard> type must be one of 'WORD' | 'SENTENCE' | 'EXPRESSION'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|label|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, disabled, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='VennCircle'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|color|key|ref|className|style|children)$/]",
        "message": "<VennCircle> doesn't accept that prop. Declared props: label, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Waveform'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|height|style|key|ref|className|style|children)$/]",
        "message": "<Waveform> doesn't accept that prop. Declared props: active, height, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
